{
  "name": "canaryguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "start:all": "node scripts/start-platform.mjs",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:demo": "npm run dev -w apps/demo-app",
    "dev:demo:baseline": "npm run dev:baseline -w apps/demo-app",
    "dev:demo:canary": "npm run dev:canary -w apps/demo-app",
    "dev:proxy": "npm run dev -w apps/proxy",
    "dev:worker": "npm run dev -w workers/workflow-worker",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --build --dry",
    "db:generate": "npm run generate -w packages/db",
    "db:push": "npm run push -w packages/db",
    "db:seed": "npm run seed -w packages/db",
    "db:studio": "npm run studio -w packages/db",
    "db:migrate": "npm run migrate -w packages/db"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
